<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="openlabel" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>OpenLabel</label>
            <tab>iranimij</tab>
            <resource>Iranimij_OpenLabel::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable OpenLabel</label>
                    <comment>Turns label rendering on for this scope. Labels are still indexed while disabled.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="default_max_labels" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Default max labels per position</label>
                    <comment>Used for new placements. Labels beyond this number in one corner are hidden by priority. 1 to 10.</comment>
                    <validate>validate-digits validate-digits-range digits-range-1-10</validate>
                </field>
                <field id="index_mode" translate="label" type="label" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Label indexer</label>
                    <frontend_model>Iranimij\OpenLabel\Block\Adminhtml\System\Config\IndexMode</frontend_model>
                </field>
                <field id="css_regenerate" translate="label comment" type="button" sortOrder="35" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Label stylesheet</label>
                    <comment>Rebuilt automatically after every design or label save. Use this after copying the database or media folder from another environment.</comment>
                    <frontend_model>Iranimij\OpenLabel\Block\Adminhtml\System\Config\RegenerateCss</frontend_model>
                </field>
                <field id="hidden_pages" translate="label comment" type="multiselect" sortOrder="38" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Hide labels on these pages</label>
                    <comment>No labels on the selected pages, for example a home page full of banners. Flush the page cache after a change.</comment>
                    <source_model>Iranimij\OpenLabel\Model\Source\HiddenPages</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="hidden_actions" translate="label comment" type="textarea" sortOrder="39" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hide labels on these other pages</label>
                    <comment>Full action names, one per line, e.g. brand_index_view for a brand page.</comment>
                </field>
                <field id="debug" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Debug mode</label>
                    <comment>Adds data-ol-label attributes with label IDs to the shop's markup, to help with support. Keep off in production.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="variables" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Label text variables</label>
                <field id="brand_attribute" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Brand attribute</label>
                    <comment>Attribute code that {BRAND} shows, e.g. manufacturer. Set "Used in Product Listing" to Yes on the attribute so category pages can show it.</comment>
                    <validate>validate-code</validate>
                </field>
            </group>
            <group id="images" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Images</label>
                <field id="max_upload_kb" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Largest image upload (KB)</label>
                    <comment>Label images above this size are refused (50 to 5120). Files over 50 KB already get a warning: small images keep listings fast.</comment>
                    <validate>validate-digits validate-digits-range digits-range-50-5120</validate>
                </field>
            </group>
        </section>
        <section id="openlabel_css" translate="label" type="text" sortOrder="11" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>OpenLabel custom CSS</label>
            <tab>iranimij</tab>
            <resource>Iranimij_OpenLabel::global_css</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Global CSS</label>
                <field id="global_css" translate="label comment" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>CSS for all labels</label>
                    <comment>Added after all designs in the label stylesheet of every store. @import, expressions, script URLs and escapes are removed when you save.</comment>
                    <backend_model>Iranimij\OpenLabel\Model\Config\Backend\GlobalCss</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
