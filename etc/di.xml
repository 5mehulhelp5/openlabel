<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Iranimij\OpenLabel\Api\Data\LabelInterface" type="Iranimij\OpenLabel\Model\Label"/>
    <preference for="Iranimij\OpenLabel\Api\Data\DesignInterface" type="Iranimij\OpenLabel\Model\Design"/>
    <preference for="Iranimij\OpenLabel\Api\Data\PlacementInterface" type="Iranimij\OpenLabel\Model\Placement"/>
    <preference for="Iranimij\OpenLabel\Api\Data\LabelSearchResultsInterface" type="Iranimij\OpenLabel\Model\LabelSearchResults"/>
    <preference for="Iranimij\OpenLabel\Api\Data\DesignSearchResultsInterface" type="Iranimij\OpenLabel\Model\DesignSearchResults"/>
    <preference for="Iranimij\OpenLabel\Api\LabelRepositoryInterface" type="Iranimij\OpenLabel\Model\LabelRepository"/>
    <preference for="Iranimij\OpenLabel\Api\DesignRepositoryInterface" type="Iranimij\OpenLabel\Model\DesignRepository"/>
    <preference for="Iranimij\OpenLabel\Api\Data\ResolvedLabelInterface" type="Iranimij\OpenLabel\Model\Resolver\ResolvedLabel"/>
    <preference for="Iranimij\OpenLabel\Api\LabelResolverInterface" type="Iranimij\OpenLabel\Model\Resolver\LabelResolver"/>
    <type name="Iranimij\OpenLabel\Model\Condition\ConditionPool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="on_sale" xsi:type="string">Iranimij\OpenLabel\Model\Condition\OnSale</item>
                <item name="is_new" xsi:type="string">Iranimij\OpenLabel\Model\Condition\IsNew</item>
                <item name="stock" xsi:type="string">Iranimij\OpenLabel\Model\Condition\Stock</item>
                <item name="price_range" xsi:type="string">Iranimij\OpenLabel\Model\Condition\PriceRange</item>
                <item name="rating" xsi:type="string">Iranimij\OpenLabel\Model\Condition\Rating</item>
                <item name="review_count" xsi:type="string">Iranimij\OpenLabel\Model\Condition\ReviewCount</item>
                <item name="bestseller" xsi:type="string">Iranimij\OpenLabel\Model\Condition\Bestseller</item>
                <item name="most_viewed" xsi:type="string">Iranimij\OpenLabel\Model\Condition\MostViewed</item>
                <item name="free_shipping" xsi:type="string">Iranimij\OpenLabel\Model\Condition\FreeShipping</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenLabel\Api\LabelRepositoryInterface">
        <plugin name="openlabel_reindex_label_on_save" type="Iranimij\OpenLabel\Plugin\LabelRepositoryPlugin"/>
        <plugin name="openlabel_regenerate_css" type="Iranimij\OpenLabel\Plugin\RegenerateCssPlugin"/>
    </type>
    <type name="Iranimij\OpenLabel\Api\DesignRepositoryInterface">
        <plugin name="openlabel_regenerate_css" type="Iranimij\OpenLabel\Plugin\RegenerateCssPlugin"/>
        <plugin name="openlabel_clean_design_cache" type="Iranimij\OpenLabel\Plugin\DesignCachePlugin"/>
    </type>
    <type name="Magento\Catalog\Model\Indexer\Product\Price\Action\Rows">
        <plugin name="openlabel_schedule_after_price_rows" type="Iranimij\OpenLabel\Plugin\Indexer\PriceRows"/>
    </type>
    <type name="Magento\Catalog\Model\Indexer\Product\Price\Action\Full">
        <plugin name="openlabel_invalidate_after_price_full" type="Iranimij\OpenLabel\Plugin\Indexer\PriceFull"/>
    </type>
    <type name="Magento\CatalogInventory\Model\Indexer\Stock\Action\Rows">
        <plugin name="openlabel_schedule_after_stock_rows" type="Iranimij\OpenLabel\Plugin\Indexer\StockRows"/>
    </type>
    <type name="Magento\CatalogInventory\Model\Indexer\Stock\Action\Full">
        <plugin name="openlabel_invalidate_after_stock_full" type="Iranimij\OpenLabel\Plugin\Indexer\StockFull"/>
    </type>
    <type name="Magento\Review\Model\ResourceModel\Review">
        <plugin name="openlabel_schedule_after_review_aggregate" type="Iranimij\OpenLabel\Plugin\Indexer\ReviewAggregate"/>
    </type>
    <type name="Iranimij\OpenLabel\Model\Variable\Pool">
        <arguments>
            <argument name="processors" xsi:type="array">
                <item name="SavePercent" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\SavePercent</item>
                <item name="SaveAmount" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\SaveAmount</item>
                <item name="Price" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\Price</item>
                <item name="SpecialPrice" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\SpecialPrice</item>
                <item name="FinalPrice" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\FinalPrice</item>
                <item name="StockQty" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\StockQty</item>
                <item name="NewFor" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\NewFor</item>
                <item name="Sku" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\Sku</item>
                <item name="Attr" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\Attr</item>
                <item name="Br" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\Br</item>
                <item name="SpecialEndsIn" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\SpecialEndsIn</item>
                <item name="SpecialEndDate" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\SpecialEndDate</item>
                <item name="Rating" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\Rating</item>
                <item name="ReviewCount" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\ReviewCount</item>
                <item name="SoldLast30d" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\SoldLast30d</item>
                <item name="CategoryName" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\CategoryName</item>
                <item name="Brand" xsi:type="object">Iranimij\OpenLabel\Model\Variable\Processor\Brand</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="openlabel_reindex" xsi:type="object">Iranimij\OpenLabel\Console\Reindex</item>
                <item name="openlabel_preview" xsi:type="object">Iranimij\OpenLabel\Console\Preview</item>
                <item name="openlabel_css_regenerate" xsi:type="object">Iranimij\OpenLabel\Console\CssRegenerate</item>
                <item name="openlabel_export" xsi:type="object">Iranimij\OpenLabel\Console\Export</item>
                <item name="openlabel_import" xsi:type="object">Iranimij\OpenLabel\Console\Import</item>
                <item name="openlabel_import_smile" xsi:type="object">Iranimij\OpenLabel\Console\ImportSmile</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="openlabel_label_listing_data_source" xsi:type="string">Iranimij\OpenLabel\Model\ResourceModel\Label\Grid\Collection</item>
                <item name="openlabel_design_listing_data_source" xsi:type="string">Iranimij\OpenLabel\Model\ResourceModel\Design\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenLabel\Model\ResourceModel\Label\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">openlabel_label</argument>
            <argument name="resourceModel" xsi:type="string">Iranimij\OpenLabel\Model\ResourceModel\Label</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenLabel\Model\ResourceModel\Design\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">openlabel_design</argument>
            <argument name="resourceModel" xsi:type="string">Iranimij\OpenLabel\Model\ResourceModel\Design</argument>
        </arguments>
    </type>
    <!-- Logging channel "openlabel" (var/log/openlabel.log): indexing and save errors with their cause. -->
    <virtualType name="Iranimij\OpenLabel\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/openlabel.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Iranimij\OpenLabel\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">openlabel</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Iranimij\OpenLabel\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Iranimij\OpenLabel\Plugin\LabelRepositoryPlugin">
        <arguments>
            <argument name="logger" xsi:type="object">Iranimij\OpenLabel\Logger</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenLabel\Controller\Adminhtml\Label\Save">
        <arguments>
            <argument name="logger" xsi:type="object">Iranimij\OpenLabel\Logger</argument>
        </arguments>
    </type>
    <type name="Iranimij\OpenLabel\Model\ImportExport\Importer">
        <arguments>
            <argument name="logger" xsi:type="object">Iranimij\OpenLabel\Logger</argument>
        </arguments>
    </type>
</config>
