<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Catalog::catalog">
                    <resource id="Iranimij_OpenLabel::openlabel" title="OpenLabel" translate="title" sortOrder="50">
                        <resource id="Iranimij_OpenLabel::labels" title="Labels" translate="title" sortOrder="10"/>
                        <resource id="Iranimij_OpenLabel::designs" title="Designs" translate="title" sortOrder="20"/>
                        <resource id="Iranimij_OpenLabel::custom_css" title="Edit custom CSS of designs" translate="title" sortOrder="30"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Iranimij_Base::config">
                                <resource id="Iranimij_OpenLabel::config" title="OpenLabel" translate="title" sortOrder="10"/>
                                <resource id="Iranimij_OpenLabel::global_css" title="OpenLabel custom CSS" translate="title" sortOrder="11"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
