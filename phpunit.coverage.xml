<?xml version="1.0" encoding="UTF-8"?>
<!-- Coverage job: unit tests against the module's own Composer dependencies (no Magento application). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         colors="true"
         bootstrap="Test/Unit/bootstrap-standalone.php"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Iranimij_OpenLabel unit">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">Model/Variable</directory>
            <directory suffix=".php">Model/Condition</directory>
            <directory suffix=".php">Model/Resolver</directory>
            <directory suffix=".php">Model/Rule</directory>
            <directory suffix=".php">Model/Html</directory>
            <directory suffix=".php">Model/Css</directory>
            <directory suffix=".php">Model/Image</directory>
            <directory suffix=".php">Model/GraphQl</directory>
        </include>
    </source>
</phpunit>
