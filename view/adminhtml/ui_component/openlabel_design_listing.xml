<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openlabel_design_listing.openlabel_design_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Design</label>
            </button>
        </buttons>
        <spinner>openlabel_design_columns</spinner>
        <deps>
            <dep>openlabel_design_listing.openlabel_design_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openlabel_design_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">design_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Iranimij_OpenLabel::designs</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="openlabel_design_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>design_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected designs? Built-in designs and designs used by labels are kept.</message>
                        <title translate="true">Delete designs</title>
                    </confirm>
                    <url path="openlabel/design/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="openlabel_design_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>design_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="design_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="thumb" class="Iranimij\OpenLabel\Ui\Component\Listing\Column\DesignThumb" sortOrder="20">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
                <label translate="true">Preview</label>
            </settings>
        </column>
        <column name="name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="type" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Iranimij\OpenLabel\Model\Source\DesignType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="is_system" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Built-in (locked)</label>
            </settings>
        </column>
        <column name="used_by" sortOrder="60">
            <settings>
                <label translate="true">Used by labels</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Iranimij\OpenLabel\Ui\Component\Listing\Column\RowActions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="editUrlPath" xsi:type="string">openlabel/design/edit</item>
                    <item name="indexField" xsi:type="string">design_id</item>
                </item>
            </argument>
            <settings>
                <indexField>design_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
