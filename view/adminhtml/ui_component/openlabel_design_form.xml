<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">openlabel_design_form.openlabel_design_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Design</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Iranimij\OpenLabel\Block\Adminhtml\Design\Edit\BackButton"/>
            <button name="delete" class="Iranimij\OpenLabel\Block\Adminhtml\Design\Edit\DeleteButton"/>
            <button name="duplicate" class="Iranimij\OpenLabel\Block\Adminhtml\Design\Edit\DuplicateButton"/>
            <button name="save" class="Iranimij\OpenLabel\Block\Adminhtml\Design\Edit\SaveButton"/>
        </buttons>
        <namespace>openlabel_design_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>openlabel_design_form.openlabel_design_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="openlabel_design_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="openlabel/design/save"/>
        </settings>
        <dataProvider class="Iranimij\OpenLabel\Ui\DataProvider\Design\Form" name="openlabel_design_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>design_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Design</label>
            <collapsible>false</collapsible>
        </settings>
        <container name="locked_notice" component="Magento_Ui/js/form/components/html" sortOrder="5">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">message message-notice ol-locked-notice</item>
                    <item name="content" xsi:type="string" translate="true">This is a built-in design. It is locked so you never lose the original: use "Duplicate to edit" to make your own version.</item>
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="imports" xsi:type="array">
                        <item name="visible" xsi:type="string">${ $.provider }:data.is_system_flag</item>
                    </item>
                </item>
            </argument>
        </container>
        <field name="design_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>design_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <label translate="true">Name</label>
                <notice translate="true">Only you see this name, e.g. "Red sale pill".</notice>
                <dataType>text</dataType>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="type" formElement="select" component="Iranimij_OpenLabel/js/form/element/type-cards" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">text</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Type</label>
                <dataType>text</dataType>
                <dataScope>type</dataScope>
                <elementTmpl>Iranimij_OpenLabel/form/element/type-cards</elementTmpl>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>text</value>
                            <actions>
                                <action name="0"><target>openlabel_design_form.openlabel_design_form.text</target><callback>visible</callback><params><param name="0" xsi:type="boolean">true</param></params></action>
                                <action name="1"><target>openlabel_design_form.openlabel_design_form.shape</target><callback>visible</callback><params><param name="0" xsi:type="boolean">false</param></params></action>
                                <action name="2"><target>openlabel_design_form.openlabel_design_form.image</target><callback>visible</callback><params><param name="0" xsi:type="boolean">false</param></params></action>
                                <action name="3"><target>openlabel_design_form.openlabel_design_form.colours</target><callback>visible</callback><params><param name="0" xsi:type="boolean">true</param></params></action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>shape</value>
                            <actions>
                                <action name="0"><target>openlabel_design_form.openlabel_design_form.text</target><callback>visible</callback><params><param name="0" xsi:type="boolean">true</param></params></action>
                                <action name="1"><target>openlabel_design_form.openlabel_design_form.shape</target><callback>visible</callback><params><param name="0" xsi:type="boolean">true</param></params></action>
                                <action name="2"><target>openlabel_design_form.openlabel_design_form.image</target><callback>visible</callback><params><param name="0" xsi:type="boolean">false</param></params></action>
                                <action name="3"><target>openlabel_design_form.openlabel_design_form.colours</target><callback>visible</callback><params><param name="0" xsi:type="boolean">true</param></params></action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>image</value>
                            <actions>
                                <action name="0"><target>openlabel_design_form.openlabel_design_form.text</target><callback>visible</callback><params><param name="0" xsi:type="boolean">false</param></params></action>
                                <action name="1"><target>openlabel_design_form.openlabel_design_form.shape</target><callback>visible</callback><params><param name="0" xsi:type="boolean">false</param></params></action>
                                <action name="2"><target>openlabel_design_form.openlabel_design_form.image</target><callback>visible</callback><params><param name="0" xsi:type="boolean">true</param></params></action>
                                <action name="3"><target>openlabel_design_form.openlabel_design_form.colours</target><callback>visible</callback><params><param name="0" xsi:type="boolean">false</param></params></action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenLabel\Model\Source\DesignType"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="text" sortOrder="20">
        <settings>
            <label translate="true">Text</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="store_texts_text" formElement="input" component="Iranimij_OpenLabel/js/form/element/text-with-variables" sortOrder="10">
            <settings>
                <label translate="true">Label text</label>
                <notice translate="true">Keep it short: 24 characters or fewer read well on a thumbnail. Use the menu to insert a variable.</notice>
                <dataType>text</dataType>
                <dataScope>store_texts.0.text</dataScope>
                <elementTmpl>Iranimij_OpenLabel/form/element/text-with-variables</elementTmpl>
            </settings>
        </field>
        <field name="font_size" formElement="input" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">14</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Largest font size (px)</label>
                <notice translate="true">Text scales with the image and never goes below 11 px on mobile or 12 px on desktop.</notice>
                <dataType>number</dataType>
                <dataScope>font_size</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="colours" sortOrder="30">
        <settings>
            <label translate="true">Colours</label>
            <collapsible>false</collapsible>
        </settings>
        <colorPicker name="bg_color" sortOrder="10">
            <settings>
                <label translate="true">Background</label>
                <dataScope>bg_color</dataScope>
                <colorFormat>hex</colorFormat>
                <colorPickerMode>full</colorPickerMode>
            </settings>
        </colorPicker>
        <colorPicker name="text_color" sortOrder="20">
            <settings>
                <label translate="true">Text colour</label>
                <dataScope>text_color</dataScope>
                <colorFormat>hex</colorFormat>
                <colorPickerMode>full</colorPickerMode>
            </settings>
        </colorPicker>
        <container name="contrast" component="Iranimij_OpenLabel/js/form/element/contrast-badge" sortOrder="25">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">Iranimij_OpenLabel/form/element/contrast-badge</item>
                    <item name="imports" xsi:type="array">
                        <item name="background" xsi:type="string">${ $.provider }:data.bg_color</item>
                        <item name="foreground" xsi:type="string">${ $.provider }:data.text_color</item>
                    </item>
                </item>
            </argument>
        </container>
        <colorPicker name="border_color" sortOrder="30">
            <settings>
                <label translate="true">Border colour</label>
                <dataScope>border_color</dataScope>
                <colorFormat>hex</colorFormat>
                <colorPickerMode>full</colorPickerMode>
            </settings>
        </colorPicker>
        <field name="border_width" formElement="input" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Border width (px)</label>
                <dataType>number</dataType>
                <dataScope>border_width</dataScope>
                <validation>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="shape" sortOrder="40">
        <settings>
            <label translate="true">Shape</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="shape" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">pill</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Shape</label>
                <dataType>text</dataType>
                <dataScope>shape</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenLabel\Model\Source\Shape"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="rotation" formElement="select" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Rotation</label>
                <notice translate="true">Corner ribbons usually look best at -45°.</notice>
                <dataType>text</dataType>
                <dataScope>rotation</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenLabel\Model\Source\Rotation"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="image" sortOrder="50">
        <settings>
            <label translate="true">Image</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="image" formElement="imageUploader" sortOrder="10">
            <settings>
                <label translate="true">Image</label>
                <notice translate="true">PNG, JPG, GIF, WebP, AVIF or SVG. SVG stays sharp at every size; files over 50 KB slow down listings.</notice>
                <componentType>imageUploader</componentType>
                <dataScope>image</dataScope>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>png jpg jpeg gif webp avif svg</allowedExtensions>
                        <maxFileSize>1048576</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">openlabel/design/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Iranimij_OpenLabel/form/element/image-preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="store_texts_alt" formElement="input" sortOrder="20">
            <settings>
                <label translate="true">Alternative text</label>
                <notice translate="true">Required for images: screen readers announce it with the product, e.g. "Sale 25 percent off".</notice>
                <dataType>text</dataType>
                <dataScope>store_texts.0.alt_text</dataScope>
            </settings>
        </field>
    </fieldset>
    <fieldset name="size" sortOrder="60">
        <settings>
            <label translate="true">Size</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="size_mode" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">percent</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Size unit</label>
                <notice translate="true">Percent of the product image width keeps the badge in proportion on thumbnails and the gallery.</notice>
                <dataType>text</dataType>
                <dataScope>size_mode</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenLabel\Model\Source\SizeMode"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="width" formElement="input" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">18</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Width</label>
                <dataType>number</dataType>
                <dataScope>width</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="height" formElement="input" sortOrder="30">
            <settings>
                <label translate="true">Height</label>
                <notice translate="true">Leave empty to fit the text.</notice>
                <dataType>number</dataType>
                <dataScope>height</dataScope>
            </settings>
        </field>
        <field name="opacity" formElement="input" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">100</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Opacity (%)</label>
                <dataType>number</dataType>
                <dataScope>opacity</dataScope>
                <validation>
                    <rule name="validate-digits-range" xsi:type="string">0-100</rule>
                </validation>
            </settings>
        </field>
        <field name="sizes_sm_width" formElement="input" sortOrder="50">
            <settings>
                <label translate="true">Phones: width</label>
                <notice translate="true">Optional. Overrides the width (in the size unit above) and the largest font size (px) on this screen size.</notice>
                <dataType>number</dataType>
                <dataScope>sizes.sm.width</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="sizes_sm_font_size" formElement="input" sortOrder="51">
            <settings>
                <label translate="true">Phones: font size (px)</label>
                <dataType>number</dataType>
                <dataScope>sizes.sm.font_size</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="sizes_md_width" formElement="input" sortOrder="52">
            <settings>
                <label translate="true">Tablets: width</label>
                <dataType>number</dataType>
                <dataScope>sizes.md.width</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="sizes_md_font_size" formElement="input" sortOrder="53">
            <settings>
                <label translate="true">Tablets: font size (px)</label>
                <dataType>number</dataType>
                <dataScope>sizes.md.font_size</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="sizes_lg_width" formElement="input" sortOrder="54">
            <settings>
                <label translate="true">Desktops: width</label>
                <dataType>number</dataType>
                <dataScope>sizes.lg.width</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="sizes_lg_font_size" formElement="input" sortOrder="55">
            <settings>
                <label translate="true">Desktops: font size (px)</label>
                <dataType>number</dataType>
                <dataScope>sizes.lg.font_size</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="motion" sortOrder="65">
        <settings>
            <label translate="true">Motion</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="animation" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">none</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Entry animation</label>
                <notice translate="true">Plays once when the label appears. Shoppers who ask their device for reduced motion never see it.</notice>
                <dataType>text</dataType>
                <dataScope>animation</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenLabel\Model\Source\Animation"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="hover_effect" formElement="select" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">none</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Hover effect</label>
                <notice translate="true">While the shopper points at the product. Not on touch screens or with reduced motion.</notice>
                <dataType>text</dataType>
                <dataScope>hover_effect</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Iranimij\OpenLabel\Model\Source\HoverEffect"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="store_views" sortOrder="70">
        <settings>
            <label translate="true">Text per store view</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
    </fieldset>
    <fieldset name="custom_css" sortOrder="80">
        <settings>
            <label translate="true">Custom CSS</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="custom_css" formElement="textarea" sortOrder="10">
            <settings>
                <label translate="true">Custom CSS</label>
                <notice translate="true">For developers. Added to the end of the shop's label stylesheet; scripts, imports and external URLs are removed. Target this design with .ol-d-ID.</notice>
                <dataType>text</dataType>
                <dataScope>custom_css</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
