/**
 * Label stacks of one product in one area, placed inside a positioned image wrapper (`ol-anchor`).
 * Markup contract (stable from 1.0): ol-stack, ol-stack--v|h, ol-pos-*, ol-label, ol-label--text|image|shape,
 * ol-d-<id>, ol-shape-*. 1.1 adds ol-inline*, ol-anim-*, ol-hover-*, ol-label--link (an <a> instead of the <span>)
 * and ol-has-tip followed by its ol-tip sibling. No inline styles, no scripts.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var array<int, array{classes: string, labels: array<int, array<string, mixed>>}> $stacks */
$stacks = $block->getData('stacks') ?: [];
?>
<?php foreach ($stacks as $stack): ?>
<span class="<?= $escaper->escapeHtml($stack['classes']) ?>"><?php foreach ($stack['labels'] as $label):
    $link = $label['link'] ?? null;
    $tip = $label['tooltip'] ?? null;
    $tag = $link !== null ? 'a' : 'span';
    ?><<?= /* @noEscape */ $tag ?> class="<?= $escaper->escapeHtml($label['classes']) ?>"<?php if ($link !== null): ?> href="<?= $escaper->escapeUrl($link['href']) ?>"<?php if ($link['rel'] !== null): ?> rel="<?= $escaper->escapeHtmlAttr($link['rel']) ?>"<?php endif; ?><?php endif; ?><?php if ($tip !== null): ?> aria-describedby="<?= $escaper->escapeHtmlAttr($tip['id']) ?>"<?php if ($tip['focusable']): ?> tabindex="0"<?php endif; ?><?php endif; ?><?php if ($label['debug_id'] !== null): ?> data-ol-label="<?= (int) $label['debug_id'] ?>"<?php endif; ?>><?php if ($label['image'] !== null): ?><img src="<?= $escaper->escapeUrl($label['image']['src']) ?>" alt="<?= $escaper->escapeHtml($label['image']['alt']) ?>"<?php if ($label['image']['width'] && $label['image']['height']): ?> width="<?= (int) $label['image']['width'] ?>" height="<?= (int) $label['image']['height'] ?>"<?php endif; ?> loading="<?= $escaper->escapeHtml($label['image']['loading']) ?>" decoding="async"><?php else: ?><?= /* @noEscape escaped and allow-listed by the variable renderer */ $label['html'] ?><?php endif; ?></<?= /* @noEscape */ $tag ?>><?php if ($tip !== null): ?><span class="ol-tip" role="tooltip" id="<?= $escaper->escapeHtmlAttr($tip['id']) ?>"><?= /* @noEscape escaped and allow-listed by the variable renderer */ $tip['html'] ?></span><?php endif; ?><?php endforeach; ?></span>
<?php endforeach; ?>
